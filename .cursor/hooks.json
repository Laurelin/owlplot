{
  "version": 1,
  "hooks": {
    "afterShellExecution": [
      {
        "command": "node .cursor/hooks/audit-fix-on-warning.mjs",
        "matcher": "\\bnpm\\b",
        "timeout": 120,
        "failClosed": false
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/crap-before-commit.mjs",
        "matcher": "git(?:\\s+-\\S+)*\\s+commit",
        "timeout": 120,
        "failClosed": true
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/audit-force-followup.mjs",
        "loop_limit": 1
      }
    ]
  }
}
