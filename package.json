{
  "name": "owlplot",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run -w @owlplot/core build && npm run -w @owlplot/renderer-svg build && npm exec -w owlplot-react-playground -w owlplot-svg-playground -- vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "crap:check": "node scripts/check-crap.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "lint": "eslint . --ignore-pattern '**/dist/**'",
    "dev:demo": "npm --workspace apps/svg-playground run dev",
    "dev:react": "npm --workspace apps/react-playground run dev",
    "build:demo": "npm --workspace apps/svg-playground run build",
    "deploy:demo": "npm run build:demo && npx gh-pages -d apps/svg-playground/dist",
    "ci": "npm run build && npm run typecheck && npm run check:exports && npm run lint && npm run test:coverage && npm run crap:check",
    "check:exports": "node scripts/check-exports.mjs",
    "control": "node scripts/run-ts.mjs scripts/control.ts",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p packages/renderer-svg/tsconfig.typecheck.json && tsc -p tsconfig.root.json",
    "test:coverage": "vitest run --project '!exports' --coverage.enabled=true --coverage.provider=istanbul --coverage.reporter=json --coverage.reporter=text --coverage.reportsDirectory=coverage"
  },
  "devDependencies": {
    "@barney-media/crap-typescript": "^0.5.2",
    "@eslint/js": "^9.39.2",
    "@vitest/coverage-istanbul": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
